# Copy to .env and fill in. Server-side ONLY — never exposed to the browser (§11).
SARVAM_API_KEY=

# Optional overrides (defaults are set in lib/sarvam.js):
# SARVAM_BASE_URL=https://api.sarvam.ai
# SARVAM_CHAT_MODEL=sarvam-105b
# SARVAM_VISION_MODEL=sarvam-105b
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_TTS_SPEAKER=anushka
# SARVAM_STT_MODEL=saaras:v3

PORT=3400
# When SARVAM_API_KEY is empty the app runs in MOCK mode (deterministic fake
# model output) so the full UI/pipeline works without a key — for the demo the
# real key is dropped in and every call becomes live.
