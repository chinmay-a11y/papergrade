# Copy to .env and fill in. Server-side ONLY — never exposed to the browser (§11).
SARVAM_API_KEY=

# Optional overrides (defaults are set in lib/sarvam.js):
# SARVAM_BASE_URL=https://api.sarvam.ai
# SARVAM_CHAT_MODEL=sarvam-105b
# SARVAM_TTS_MODEL=bulbul:v2          # bulbul:v3 uses different speakers
# SARVAM_TTS_SPEAKER=anushka
# SARVAM_STT_MODEL=saarika:v2.5       # Saarika transcribes (keeps source language)
# Handwriting OCR uses the Doc AI digitise job (async) — no model id to set.
# SARVAM_DOCAI_MAX_WAIT_MS=40000

# --- Claude (Anthropic) fallback grader ---------------------------------
# Optional alternative engine for booklet grading: Claude scans the student's
# page images and compares them to the answer key in one vision call. Handy when
# Sarvam has no credits. Set the key, then AI_PROVIDER=claude to route booklet
# grading through Claude (Sarvam stays the default).
# ANTHROPIC_API_KEY=
# AI_PROVIDER=claude
# ANTHROPIC_MODEL=claude-opus-5      # or claude-sonnet-5 for lower cost

PORT=3400
# When SARVAM_API_KEY is empty the app runs in MOCK mode (deterministic fake
# model output) so the full UI/pipeline works without a key — for the demo the
# real key is dropped in and every call becomes live.
